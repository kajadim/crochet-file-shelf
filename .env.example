# Optional settings for docker compose. Copy to .env (it is not committed).

# Secret used to sign login tokens in the containerised backend.
JWT_SECRET=replace-with-a-long-random-string

# Only needed to register new users in the containerised app (verification code is sent by email).
EMAIL_SENDER=your.address@gmail.com
EMAIL_USERNAME=your.address@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
