# Frontend (Angular) - build artefacts, dependencies and IDE junk are already
# covered by frontend/.gitignore (auto-generated by Angular CLI, applies to
# everything under frontend/). Nothing Angular-specific needed here.

# Environment files (any project)
.env
*.env.local

# Project documentation
/documentation/

# Editors / OS (repo-wide, in case the whole monorepo is opened as one workspace)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Visual Studio / .NET generated files
**/bin/
**/obj/
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pdb
*.cache
*.db
*.db-shm
*.db-wal

# Local dev secrets (connection strings, per-machine overrides) - not shared via git.
# See appsettings.Development.json.example for the expected shape.
**/appsettings.Development.json
